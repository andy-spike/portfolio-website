# The Agent's model gateway. One key carries both the chat model and the
# embedding model. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Swaps the chat model without a code change; the default is
# deepseek/deepseek-v4-flash-0731.
OPENROUTER_MODEL=

# The retrieval store. Project Settings → Data API for the URL, and Project
# Settings → API Keys for a secret key (`sb_secret_…`). It bypasses row level
# security, so it is server-only and must never reach the client.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
