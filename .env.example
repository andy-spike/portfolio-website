# The Agent's model gateway. One key carries both the chat model and the
# embedding model. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Swaps the chat model without a code change; the default is
# deepseek/deepseek-v4-flash-0731.
OPENROUTER_MODEL=

# The retrieval store. Project settings → Data API, and the service role key
# under API keys — it is a server-only secret and must never reach the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
