---
import "../styles/global.css";
import Fascia from "../components/Fascia.astro";
import Colophon from "../components/Colophon.astro";
import AskMark from "../components/AskMark.astro";
import {
  useTranslations,
  localePath,
  showingText,
  type Locale,
} from "../i18n/ui";
import { CONTACT } from "../lib/contact";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Root-relative path of this page without locale prefix, e.g. "/" or "/work/dolphin" */
  path: string;
  /** A single sheet reads at a tighter trim than the index. */
  trim?: boolean;
}

const { locale, title, description, path, trim = false } = Astro.props;
const t = useTranslations(locale);

const pageTitle = title ?? t("meta.title");
const pageDescription = description ?? t("meta.description");
const canonical = new URL(localePath(locale, path), Astro.site);

/**
 * The social card is the sheet's first viewport at another magnification.
 * Regenerate both files from scripts/og-card.html whenever the showing changes.
 */
const ogImage = new URL(`/og-${locale}.png`, Astro.site);
const ogLocales: Record<Locale, string> = { en: "en_US", es: "es_CO" };
const otherLocale: Locale = locale === "en" ? "es" : "en";
---

<html lang={locale} data-path={path}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(localePath("en", path), Astro.site).href}
    />
    <link
      rel="alternate"
      hreflang="es"
      href={new URL(localePath("es", path), Astro.site).href}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath("en", path), Astro.site).href}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={CONTACT.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={ogLocales[locale]} />
    <meta property="og:locale:alternate" content={ogLocales[otherLocale]} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={showingText(locale)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={showingText(locale)} />
    <Analytics />
    <SpeedInsights />
  </head>

  <body
    ><!--
THESIS: The site is a stack of printed blocks on warm paper, not a wayfinding program and not the dark developer portfolio with one neon accent. It refuses both defaults: depth comes from ink borders and hard offset shadows, and every project carries its own saturated colour.
OWN-WORLD: Warm paper #F6F1E7, block paper #FFFDF6, near-black ink #16130D. 3px ink borders and zero-blur offset shadows as the only depth; no radius, no gradient, no blur. Dolphin yellow #F5B301, Armin orange #F4602A, Citadela teal #2FBFAE, always under black ink. Bricolage Grotesque from a 6rem block claim to body, Azeret Mono for legends and code. Primitives: brick, btn, chip, plate, ticket, window, legend, claim.
STORY: A hiring manager reads the claim set as the page's largest block, sees three shipped projects as colour-chipped rows, opens one, follows its decisions past the alternatives that were turned down, and leaves through the solid-ink GitHub block to the source.
FIRST VIEWPORT: Warm paper. A hero brick with a 3px ink border and 8px hard shadow holds the claim at up to 6rem with the emphasis word in a yellow highlight block, the description, the solid-ink GitHub button, and the small marks beside it; the portrait window sits at the right, rotated one degree. Below the brick, three stacked project tickets, each chipped with its project colour, filling with that colour as they lift.
SIGNATURE: The press. Every actionable block lifts off the paper on hover — translate -2px,-2px, the hard shadow deepening — and presses flush into the paper on active, in 120ms. The project rows and tickets fill with their project colour as they lift; the cue arrow is the page's only moving mark.
FORM: Classic web neo-brutalism, user-pinned direction (no roll); replaces the platform sign kit, seed key d8cc7f12, which is this build's anti-reference.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:bg-ink focus:px-4 focus:py-2 focus:font-bold focus:text-paper"
    >
      {t("nav.skipToContent")}
    </a>

    <Fascia locale={locale} path={path} trim={trim} />

    <main id="content" class="flex-1 pt-[var(--fascia-h)]">
      <slot />
    </main>

    <Colophon locale={locale} trim={trim} />

    {/* The way into Ask. Ask itself runs in ChatShell, not here, so there is
        no page left for this layout to withhold the mark from. */}
    <AskMark locale={locale} />
  </body>
</html>
