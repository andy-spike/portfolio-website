---
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import { getProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects('en');
  return projects.map(({ slug, entry, isFallback }) => ({
    params: { slug },
    props: { entry, isFallback },
  }));
}

const { entry, isFallback } = Astro.props;
const { slug } = Astro.params;
---

<Base
  locale="en"
  path={`/work/${slug}`}
  trim
  title={`${entry.data.title} — Andrés Sanabria`}
  description={entry.data.character}
>
  <Sheet locale="en" entry={entry} isFallback={isFallback} />
</Base>
