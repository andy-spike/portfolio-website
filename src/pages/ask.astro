---
import ChatShell from '../layouts/ChatShell.astro';
import { Chat } from '../components/chat/Chat';
import { chatStrings } from '../components/chat/strings';
import { useTranslations, localePath } from '../i18n/ui';

const t = useTranslations('en');
---

<ChatShell locale="en" path="/ask">
  <Chat
    client:load
    strings={chatStrings('en')}
    locale="en"
    homeHref={localePath('en', '/')}
    altLocaleHref={localePath('es', '/ask')}
    altLocaleLabel="ES"
    toBottomLabel={t('ask.toBottom')}
  />
</ChatShell>
