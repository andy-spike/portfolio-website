---
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import ThemeToggle from './ThemeToggle';

interface Props {
  locale: Locale;
  path: string;
  /** Match the tighter trim a single sheet uses, so the edges line up. */
  trim?: boolean;
}

const { locale, path, trim = false } = Astro.props;
const t = useTranslations(locale);

const other: Locale = locale === 'en' ? 'es' : 'en';
const otherLabel = other.toUpperCase();
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-rule bg-ground">
  <div
    class:list={[
      'sheet',
      trim && 'sheet-trim',
      'flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 py-3',
    ]}
  >
    <div class="rail flex items-baseline gap-x-5 gap-y-1">
      <a
        href={localePath(locale, '/')}
        class="rail-strong text-base font-semibold normal-case no-underline hover:text-accent-ink"
      >
        Andrés&nbsp;Sanabria
      </a>
    </div>

    <nav aria-label={t('nav.primary')} class="rail order-3 flex w-full items-baseline gap-x-5 sm:order-none sm:w-auto">
      <a href={localePath(locale, '/#projects')} class="no-underline hover:text-accent-ink">
        {t('nav.projects')}
      </a>
      <a href={localePath(locale, '/#casts')} class="no-underline hover:text-accent-ink">
        {t('nav.casts')}
      </a>
      <a href={localePath(locale, '/#about')} class="no-underline hover:text-accent-ink">
        {t('nav.about')}
      </a>
    </nav>

    <div class="rail flex items-center gap-x-4">
      <a
        href={localePath(other, path)}
        class="no-underline hover:text-accent-ink"
        lang={other}
        hreflang={other}
        title={t('rail.lang')}
      >
        {otherLabel}
      </a>
      <span aria-hidden="true" class="h-3 w-px bg-rule"></span>
      <ThemeToggle
        client:load
        label={t('rail.theme')}
        lightLabel={t('theme.light')}
        darkLabel={t('theme.dark')}
        systemLabel={t('theme.system')}
      />
    </div>
  </div>
</header>
