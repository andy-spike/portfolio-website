---
import { useTranslations, type Locale } from '../i18n/ui';
import { CONTACT } from '../lib/contact';
import { cn } from '../lib/utils';
import { buttonVariants } from './ui/button';
import { FileText, Mail } from 'lucide-react';
import BrandIcon from './BrandIcon.astro';

interface Props {
  locale: Locale;
  /**
   * Which action takes the accent fill. Both the showing and the colophon lead
   * with the source, because the reader wants evidence before an ask, and the
   * two rows read as the same row twice rather than as two different offers.
   */
  primary?: 'github' | 'email';
}
const { locale, primary = 'github' } = Astro.props;
const t = useTranslations(locale);

const leadsWithEmail = primary === 'email';

/** Whatever is not the primary action stays in the row of small marks. */
const iconLinks = [
  { key: 'resume', label: t('contact.resume'), href: CONTACT.resume, download: true },
  { key: 'linkedin', label: t('contact.linkedin'), href: CONTACT.linkedin },
  ...(leadsWithEmail
    ? []
    : [{ key: 'email', label: t('contact.email'), href: CONTACT.mailto }]),
  { key: 'x', label: t('contact.x'), href: CONTACT.x },
] as const;

const iconLinkClass = cn(buttonVariants({ variant: 'outline', size: 'icon-lg' }), 'touch-target');
/** The résumé is the one mark that names itself — it is the file a recruiter forwards. */
const namedLinkClass = cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'font-mono px-4');
const primaryClass = cn(buttonVariants({ variant: 'default', size: 'lg' }), 'font-mono');
const secondaryClass = cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'font-mono');
---

<div class="flex flex-wrap items-center gap-x-6 gap-y-3">
  <div class="flex flex-wrap items-center gap-3">
    {
      leadsWithEmail ? (
        <>
          <a href={CONTACT.mailto} class={cn(primaryClass, 'normal-case tracking-normal')}>
            <Mail size={16} className="size-4 shrink-0" />
            {CONTACT.email}
          </a>
          <a href={CONTACT.github} class={secondaryClass} target="_blank" rel="noopener noreferrer">
            <BrandIcon name="github" />
            {t('contact.github')}
          </a>
        </>
      ) : (
        <a href={CONTACT.github} class={primaryClass} target="_blank" rel="noopener noreferrer">
          <BrandIcon name="github" />
          {t('contact.github')}
        </a>
      )
    }
  </div>

  <ul class="m-0 flex list-none flex-wrap items-center gap-2 p-0">
    {
      iconLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class={link.key === 'resume' ? namedLinkClass : iconLinkClass}
            aria-label={link.key === 'resume' ? undefined : link.label}
            title={link.label}
            target={link.key === 'linkedin' || link.key === 'x' ? '_blank' : undefined}
            rel={link.key === 'linkedin' || link.key === 'x' ? 'noopener noreferrer' : undefined}
            download={link.key === 'resume' ? true : undefined}
          >
            {link.key === 'resume' && (
              <>
                <FileText size={16} className="size-4 shrink-0" />
                {link.label}
              </>
            )}
            {link.key === 'linkedin' && <BrandIcon name="linkedin" />}
            {link.key === 'email' && <Mail size={16} className="size-4 shrink-0" />}
            {link.key === 'x' && <BrandIcon name="x" />}
          </a>
        </li>
      ))
    }
  </ul>
</div>
