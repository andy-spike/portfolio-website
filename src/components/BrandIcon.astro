---
import { siGithub, siX } from 'simple-icons';
import { cn } from '../lib/utils';

/**
 * Trademarked marks, sourced from Simple Icons (maintained, CC0 path data)
 * wherever it carries them. LinkedIn is the one exception: Simple Icons
 * removed it from the package at LinkedIn's own request (see their
 * DISCLAIMER.md, "Removal of Brands"), so it stays hand-authored here —
 * the standard "in" badge, in currentColor to match the other two.
 *
 * Sized twice on purpose: the width/height attributes give every browser a
 * correct intrinsic box before any stylesheet loads, and the size-4 class
 * confirms the same number in CSS. Buttons no longer auto-size a bare
 * descendant svg — that relied on a class-substring check that silently
 * breaks the moment a caller's own class merges differently.
 */
interface Props {
  name: 'github' | 'linkedin' | 'x';
  class?: string;
}
const { name, class: className = '' } = Astro.props;

const linkedinPath =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';

const path = name === 'github' ? siGithub.path : name === 'x' ? siX.path : linkedinPath;
---

<svg
  class={cn('size-4 shrink-0', className)}
  width="16"
  height="16"
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={path} />
</svg>
