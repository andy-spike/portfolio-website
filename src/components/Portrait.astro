---
import { useTranslations, type Locale } from '../i18n/ui';
import { CONTACT } from '../lib/contact';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

{/* The portrait window: an ink-barred frame, part of the print stack. */}
<figure class="m-0 window">
  <figcaption class="window-bar">
    <span class="legend">{t('portrait.label')}</span>
    <span class="legend" aria-hidden="true">01</span>
  </figcaption>

  {
    CONTACT.portraitIsPlaceholder ? (
      /* Reserved position. Drop the headshot at public/portrait.jpg and set
         CONTACT.portraitIsPlaceholder to false — it sets in place of this. */
      <div class="hatched flex aspect-square w-full items-end p-2.5 text-ink lg:aspect-[4/5] lg:p-3">
        <span class="legend max-w-[14ch] leading-snug">{t('portrait.placeholder')}</span>
      </div>
    ) : (
      <img
        src={CONTACT.portrait}
        alt={CONTACT.name}
        width="480"
        height="600"
        class="aspect-square w-full object-cover lg:aspect-[4/5]"
      />
    )
  }
</figure>
