---
import { useTranslations, getLocaleFromUrl } from '../i18n/ui';
import { X } from 'lucide-react';

interface Props {
  /** The decision itself, stated as a decision and not as a feature. */
  title: string;
  /** What was chosen. One line. */
  set: string;
  /** What was considered and turned down. A decision without these proves nothing. */
  alternates: Array<{ name: string; why: string }>;
}

const { title, set, alternates = [] } = Astro.props;
const t = useTranslations(getLocaleFromUrl(Astro.url));
---

{/* One decision printed as its own block, with what it turned down beneath it. */}
<div class="decision">
  <h3 class="text-[clamp(1.25rem,2.2vw,1.5rem)] font-extrabold leading-tight tracking-[-0.025em]">
    {title}
  </h3>

  <p class="legend legend-strong mt-3">{t('sheet.chose')}</p>
  <p class="mt-1 text-ink">{set}</p>

  <div class="mt-4 text-[1.0625rem] leading-[1.6]">
    <slot />
  </div>

  {
    alternates.length > 0 && (
      <div class="mt-6">
        <p class="legend">{t('sheet.rejected')}</p>
        <ul class="m-0 mt-2 list-none p-0">
          {alternates.map((alt) => (
            <li class="grid grid-cols-[auto_minmax(0,1fr)] items-baseline gap-x-2.5 border-t-2 border-rule py-2.5 first:border-t-0 first:pt-0 last:pb-0">
              <X
                size={14}
                strokeWidth={3}
                className="size-3.5 shrink-0 translate-y-[1px] text-ink"
                aria-hidden="true"
              />
              <span>
                <span class="struck font-bold">{alt.name}</span>
                <span class="ink-muted mt-1 block">{alt.why}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>
