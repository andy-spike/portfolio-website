---
import { useTranslations, getLocaleFromUrl } from '../i18n/ui';

interface Props {
  /** The decision itself, stated as a decision and not as a feature. */
  title: string;
  /** What was chosen. One line. */
  set: string;
  /** What was considered and turned down. A decision without these proves nothing. */
  alternates: Array<{ name: string; why: string }>;
}

const { title, set, alternates = [] } = Astro.props;
const t = useTranslations(getLocaleFromUrl(Astro.url));
---

<div class="decision">
  <h3 class="text-[1.375rem] leading-tight tracking-[-0.025em]">{title}</h3>

  <p class="mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <span class="alt-mark border-accent text-accent-ink">{t('sheet.chose')}</span>
    <span class="text-ink">{set}</span>
  </p>

  <div class="prose-spec mt-4 text-[1rem] leading-[1.6]">
    <slot />
  </div>

  {
    alternates.length > 0 && (
      <div class="mt-6 border-t border-rule pt-4">
        <p class="rail m-0">{t('sheet.rejected')}</p>
        <ul class="alts m-0 list-none p-0">
          {alternates.map((alt, i) => (
            <li class="alt border-b border-rule last:border-b-0">
              <span class="alt-mark">alt {String.fromCharCode(97 + i)}</span>
              <span>
                <span class="alt-name text-ink-muted">{alt.name}</span>
                <span class="mt-1 block text-ink-faint">{alt.why}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>
