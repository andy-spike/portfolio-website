---
import { useTranslations, type Locale } from '../i18n/ui';
import ExitBar from './ExitBar.astro';

interface Props {
  locale: Locale;
  /** Match the tighter trim a case study uses, so the edges line up. */
  trim?: boolean;
}
const { locale, trim = false } = Astro.props;
const t = useTranslations(locale);
---

{/*
  The colophon: the sheet's last block, printed in solid ink. The actions
  reverse — paper blocks on the ink field — so the way out stays the loudest
  thing on the page to the end.
*/}
<footer class="on-ink border-t-[3px] border-ink bg-ink text-paper">
  <div class:list={['span', trim && 'span-trim', 'py-[clamp(3rem,7vw,5rem)]']}>
    <p class="max-w-[22ch] text-[clamp(1.75rem,4.4vw,3rem)] font-extrabold leading-[1] tracking-[-0.03em]">
      {t('availability')}
    </p>

    <div class="mt-[clamp(1.75rem,3.5vw,2.5rem)]">
      <ExitBar locale={locale} />
    </div>
  </div>
</footer>
