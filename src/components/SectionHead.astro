---
/**
 * A plate division: the section's name on a hairline that spans the sheet,
 * with an optional count set at the far end. Every section on the sheet is
 * ruled the same way, so the divisions read as one system.
 */
interface Props {
  id: string;
  heading: string;
  /** Mono figure set at the end of the rule — a count, never a label. */
  meta?: string;
  class?: string;
}
const { id, heading, meta, class: className = '' } = Astro.props;
---

<div class:list={['flex items-baseline justify-between gap-6 border-b border-rule-strong pb-3', className]}>
  <h2 id={id} class="rail rail-strong text-2xl leading-none">{heading}</h2>
  {meta && <span class="rail text-base leading-none" aria-hidden="true">{meta}</span>}
</div>
