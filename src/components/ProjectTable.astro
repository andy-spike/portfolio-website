---
import { useTranslations, localePath, defaultLocale, type Locale } from '../i18n/ui';
import { getProjects } from '../lib/projects';
import Arrow from './Arrow.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const projects = await getProjects(locale);
---

<section
  id="projects"
  aria-labelledby="projects-heading"
  class="sheet scroll-mt-[var(--rail-h)] pb-16 pt-20 sm:pb-24 sm:pt-28"
>
  <SectionHead
    id="projects-heading"
    heading={t('projects.heading')}
    meta={String(projects.length).padStart(2, '0')}
  />

  <ol class="m-0 mt-10 list-none p-0 sm:mt-14">
    {
      projects.map(({ slug, entry, isFallback }, i) => (
        <li>
          <a href={localePath(locale, `/work/${slug}`)} class="project-row">
            <span class="rail pt-2" style="grid-area: num;" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>

            <span class="min-w-0" style="grid-area: title;">
              <span class="project-name block text-ink">{entry.data.title}</span>
              <span
                class="mt-3 block text-ink-muted lg:hidden"
                lang={isFallback ? defaultLocale : undefined}
              >
                {entry.data.character}
              </span>
            </span>

            <span
              class="hidden text-ink-muted lg:block"
              style="grid-area: desc;"
              lang={isFallback ? defaultLocale : undefined}
            >
              {entry.data.character}
            </span>

            <span
              class="mt-4 flex flex-wrap items-baseline gap-x-4 gap-y-1 lg:mt-1 lg:flex-col lg:items-end lg:text-right"
              style="grid-area: meta;"
            >
              <span class="rail rail-strong flex items-center gap-1.5 whitespace-nowrap text-accent-ink">
                {t('projects.read')}
                <Arrow dir="right" class="translate-y-px shrink-0" />
              </span>
              <span class="rail whitespace-nowrap">{entry.data.state}</span>
              {isFallback && (
                <span class="rail whitespace-nowrap text-ink-faint">
                  <span aria-hidden="true">{defaultLocale.toUpperCase()}</span>
                  <span class="sr-only">{t('fallback.notice')}</span>
                </span>
              )}
            </span>

            <p class="rail m-0 flex flex-wrap gap-x-3 gap-y-1 text-ink-muted" style="grid-area: stack;">
              {entry.data.stack.map((tech) => (
                <span>{tech}</span>
              ))}
            </p>
          </a>
        </li>
      ))
    }
  </ol>
</section>
