---
import { render } from 'astro:content';
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import type { Specimen } from '../lib/specimens';
import Decision from './Decision.astro';
import InUse from './InUse.astro';
import Arrow from './Arrow.astro';
import BrandIcon from './BrandIcon.astro';

interface Props {
  locale: Locale;
  entry: Specimen;
  isFallback: boolean;
}

const { locale, entry, isFallback } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(entry);
const d = entry.data;

/** `mark` names the destination where it has a mark of its own; the rest carry only the out-arrow. */
const externals = [
  { label: t('sheet.source'), href: d.links.source, mark: 'github' as const },
  d.links.live ? { label: t('sheet.live'), href: d.links.live } : null,
  d.links.download ? { label: t('sheet.download'), href: d.links.download } : null,
].filter(Boolean) as Array<{ label: string; href: string; mark?: 'github' }>;

const facts = [
  { label: t('sheet.role'), value: d.role },
  { label: t('sheet.year'), value: d.year },
  { label: t('sheet.stack'), value: d.stack.join(', ') },
];
---

<article>
  <div class="sheet sheet-trim pt-[clamp(1.75rem,4vw,3rem)]">
    <a
      href={localePath(locale, '/')}
      class="rail inline-flex items-center gap-2 no-underline hover:text-accent-ink"
    >
      <Arrow dir="right" class="rotate-180" />
      {t('sheet.back')}
    </a>

    {
      isFallback && (
        <p class="rail mt-6 border-t border-accent bg-accent-wash px-4 py-3 normal-case tracking-normal text-ink">
          {t('fallback.notice')}
        </p>
      )
    }

    <div class="mt-[clamp(1.5rem,3.5vw,2.25rem)] flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 border-b border-rule-strong pb-4">
      <h1 class="showing text-ink" style="font-size: var(--text-plate);">
        {d.title}
      </h1>
      <span class="rail rail-strong">{d.state}</span>
    </div>

    <p class="mt-6 max-w-[52ch] text-[length:var(--text-lead)] leading-[1.5] text-ink-muted">
      {d.character}
    </p>
  </div>

  {
    d.cast && (
      <div class="mt-14">
        <InUse locale={locale} cast={d.cast} />
      </div>
    )
  }

  <div
    class="sheet sheet-trim grid gap-x-10 gap-y-10 pb-[clamp(3rem,7vw,5rem)] pt-[clamp(2rem,4vw,3rem)] lg:grid-cols-[minmax(0,1fr)_16rem]"
  >
    <div class="prose-spec order-2 lg:order-1">
      <Content components={{ Decision }} />
    </div>

    <aside
      class="order-1 self-start lg:order-2 lg:sticky lg:top-[calc(var(--rail-h)+2rem)] lg:border-l lg:border-rule lg:pl-10"
    >
      <dl class="m-0 border-t border-rule-strong">
        {
          facts.map((f) => (
            <div class="border-b border-rule py-3">
              <dt class="rail">{f.label}</dt>
              <dd class="m-0 mt-1.5 text-[0.9375rem] leading-snug text-ink">{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-6 flex flex-col items-start gap-2">
        {
          externals.map((link) => (
            <a
              href={link.href}
              class="rail inline-flex items-center gap-2 no-underline hover:text-accent-ink"
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.mark === 'github' && <BrandIcon name="github" class="size-3.5" />}
              {link.label}
              <Arrow dir="out" />
            </a>
          ))
        }
      </div>
    </aside>
  </div>
</article>
