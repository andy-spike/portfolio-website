---
import { useTranslations, type Locale } from '../i18n/ui';
import SectionHead from './SectionHead.astro';

interface Props {
  locale: Locale;
  /** Path to a recorded asciinema cast under /public. Renders the reserved plate when absent. */
  cast?: string;
  heading?: string;
  caption?: string;
}
const { locale, cast, heading, caption } = Astro.props;
const t = useTranslations(locale);
---

<section
  id="casts"
  aria-labelledby="in-use-heading"
  class="scroll-mt-[var(--rail-h)] border-t border-rule bg-plate"
>
  <div class="sheet py-16 sm:py-24">
    <SectionHead id="in-use-heading" heading={heading ?? t('inUse.heading')} />

    <figure class="m-0 mt-10 grid gap-8 sm:mt-14 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-14">
      <div class="min-w-0">
        <div class="border border-rule bg-ground">
          <div class="flex items-center justify-between border-b border-rule px-3 py-2">
            <span class="rail">dolphin</span>
            <span class="rail text-ink-faint">cast</span>
          </div>

          {
            cast ? (
              <div
                class="aspect-[16/10] w-full"
                data-cast={cast}
                aria-label={caption ?? t('inUse.caption')}
              />
            ) : (
              /* Reserved position. Drop the recording at public/casts/dolphin.cast
                 and pass it as `cast` — it replays in place of this plate. */
              <div class="flex aspect-[16/7] w-full flex-col items-center justify-center gap-4 px-6 text-center">
                <span class="measure w-24"></span>
                <span class="rail rail-strong">{t('inUse.placeholder')}</span>
              </div>
            )
          }
        </div>
      </div>

      <figcaption class="text-ink-muted lg:pt-2">
        <p class="max-w-[42ch]">{caption ?? t('inUse.caption')}</p>
      </figcaption>
    </figure>
  </div>
</section>
